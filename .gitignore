# ==========================================
# Dance Anonymizer .gitignore
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Model Weights & Cache ---
*.pt
*.onnx
*.tflite
*.engine
*.bin
*.weights
*.data
models/

# Phase 7 release-critical canonical artifact. Keep every other production
# model ignored, but track the single shared Android/iOS YOLO LiteRT binary so
# a clean Release checkout uses byte-identical model bytes instead of relying
# on host-dependent floating-point re-export.
!models/
models/*
!models/litert/
models/litert/*
!models/litert/README.md
!models/litert/yolo11n-seg-fp16.tflite

# Benchmark-only face model fixture. Keep production model ignores intact while
# allowing this small, source-pinned Apache-2.0 test asset to survive clean checkout.
!testdata/models/
!testdata/models/face/
!testdata/models/face/blaze_face_full_range.tflite
!testdata/models/face/README.md


# --- Flutter & Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
**/build/
pubspec.lock
!mobile/app/pubspec.lock
mobile/app/ios/Flutter/Phase7Release.xcconfig
!uv.lock


# --- Android ---
.kotlin/
**/android/.gradle/
**/android/captures/
**/android/gradleApp.setting
**/android/local.properties
**/android/**/build/
**/android/app/src/main/assets/*.onnx
**/android/app/src/main/assets/*.tflite
*.apk
*.aab
*.jks
*.keystore
mobile/app/android/key.properties

# --- iOS & macOS ---
.DS_Store
.AppleDouble
.LSOverride
**/ios/.symlinks/
**/ios/Pods/
**/ios/Podfile.lock
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/App.framework
**/ios/Flutter/App.podspec
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/Runner.xcodeproj/xcuserdata/
**/ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/

# iOS inference model bytes are provisioned from the repository-local models/
# cache and deliberately remain untracked, matching the Android asset strategy.
mobile/packages/dance_native/ios/dance_native/Sources/dance_native/Resources/InferenceAssets/*.tflite
mobile/packages/dance_native/ios/dance_native/Sources/dance_native/Resources/InferenceAssets/*.sha256

# --- IDE & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.iml

# --- Data & Temporary Storage ---
data/tasks/
debug/
!mobile/packages/dance_native/android/src/debug/
!mobile/packages/dance_native/android/src/debug/**
input/
output/
uploads/
logs/
testdata/*.mp4
*.log
*.tmp
emulator_screen.png
